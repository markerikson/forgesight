{
  "name": "forgesight",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "dev:all": "bun scripts/dev-all.ts",
    "build": "vite build",
    "start": "bun scripts/start-web.ts",
    "worker": "bun run src/worker/main.ts",
    "db:migrate": "bun run src/store/migrate-cli.ts",
