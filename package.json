{
  "name": "forgesight",
  "private": true,
  "type": "module",
  "scripts": {
    "worker": "bun run src/worker/main.ts",
    "db:migrate": "bun run src/store/migrate-cli.ts",
    "inspect": "bun run src/worker/inspect.ts",
    "fixture:record": "bun run scripts/record-fixture.ts",
    "test": "bun test src",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p src/core",
    "lint": "oxlint src/ scripts/"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "arktype": "2.1.29",
    "forges": "0.4.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.7",
    "@typescript/native-preview": "7.0.0-dev.20260127.1",
    "oxlint": "1.42.0"
  }
}
