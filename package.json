    "@timber-js/app": "0.2.0-alpha.252",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "arktype": "2.1.29",
    "dompurify": "3.5.0",
    "forges": "0.4.1",
    "marked": "18.3.0",
    "nuqs": "2.10.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.7",
    "@types/jsdom": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.1",
    "oxlint": "1.42.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
