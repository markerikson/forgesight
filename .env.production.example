# Copy to .env.production; `bun run deploy:full` uploads it to $DEPLOY_DIR/.env (mode 600).
# GitHub token for the server's worker. A classic PAT needs the notifications, repo, and read:org scopes
# (read:org lets the worker read team review requests).
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
FORGESIGHT_DATA_DIR=/opt/forgesight/data
